{
  "name": "spindle-make",
  "productName": "Spindle Make",
  "version": "0.1.5",
  "description": "Spindle / Make — from idea to pull request in one app. Powered by jsj.",
  "main": "out/main/index.js",
  "author": {
    "name": "Spindle",
    "url": "https://spindle.no"
  },
  "homepage": "https://github.com/spindle-as/make",
  "repository": {
    "type": "git",
    "url": "https://github.com/spindle-as/make.git"
  },
  "bugs": {
    "url": "https://github.com/spindle-as/make/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && node scripts/build-helpers.mjs && electron-builder --mac --arm64 --publish never",
    "dist:dir": "npm run build && node scripts/build-helpers.mjs && electron-builder --mac --arm64 --dir",
    "icon": "electron scripts/make-icon.cjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ms-madi": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "no.spindle.make",
    "productName": "Spindle Make",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "banner"
      },
      "artifactName": "Spindle-Make-${version}-${arch}-mac.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Spindle Make",
      "artifactName": "Spindle-Make-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Spindle",
    "publish": null,
    "extraResources": [
      {
        "from": "build/helpers",
        "to": "bin",
        "filter": [
          "clonedir"
        ]
      }
    ]
  }
}
